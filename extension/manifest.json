{
  "manifest_version": 3,
  "name": "Design Shelf",
  "version": "0.2.0",
  "description": "Your personal inspiration library: save images from X with notes and categories.",
  "minimum_chrome_version": "122",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://pbs.twimg.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Open my design library",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_page": "library.html",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/modal.js", "content/x.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/modal.css"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ]
}
